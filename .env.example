# STRAW — Environment Configuration Template
# Copy to .env for local overrides. Never commit .env to Git.

PORT=4310
HOST=127.0.0.1
STRAW_DB_PATH=./data/straw.sqlite

# Optional Replaceable AI Provider Keys (System runs 100% locally via deterministic engines when unset)
AI_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
